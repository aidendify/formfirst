PORT=8080
DATABASE_PATH=/data/formfirst.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
PUBLIC_BASE_URL=http://localhost:8080

# Empty → webhook returns 403 (do not leave open).
WEBHOOK_SECRET=

QUALIFY_Q1=What are you looking for help with?
QUALIFY_Q2=When do you need this done?

FROM_NAME=
FROM_EMAIL=

# Owner summary destination when SMTP is set. Leave empty to rely on the in-app inbox.
OWNER_NOTIFY_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset to copy the first-reply without sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional footer link labeled "Powered by FormFirst". Leave empty for no footer.
MARKETING_URL=
